{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;port=3306;Database=expense_db;user=root;password=Password123!;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "ThisIsASecretKeyForJWTToken12345",
    "Issuer": "ExpenseTrackerAPI",
    "Audience": "ExpenseTrackerAPIUsers",
